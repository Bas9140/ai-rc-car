<?xml version="1.0"?>
<package format="3">
  <name>rc_sensors</name>
  <version>0.1.0</version>
  <description>GPS, IMU and ultrasonic sensor nodes for AI RC Car</description>
  <maintainer email="basvenema1992@gmail.com">Bas Venema</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
