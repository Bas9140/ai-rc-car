<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rc_avoidance</name>
  <version>0.1.0</version>
  <description>
    Obstakelvermijding voor de AI RC Car.
    Fusioneert camera-dieptezones (OAK-D Lite) en ultrasoon (HC-SR04)
    tot een gecombineerde ObstacleMap en berekent uitwijkmanoeuvres.
  </description>
  <maintainer email="basvenema1992@gmail.com">Bas Venema</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>rc_interfaces</depend>

  <buildtool_depend>ament_python</buildtool_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
