<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rc_navigation</name>
  <version>0.1.0</version>
  <description>
    GPS waypoint navigatie voor de AI RC Car.
    Pure pursuit controller, complementaire GPS+IMU heading filter,
    waypoint wachtrij met statusmachine, action server voor dashboard.
    Geen Nav2 of externe kaart vereist – werkt direct op GPS+IMU.
  </description>
  <maintainer email="basvenema1992@gmail.com">Bas Venema</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rc_interfaces</depend>

  <!-- Python: geen extra pip packages nodig (alles stdlib of ROS2) -->

  <buildtool_depend>ament_python</buildtool_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
